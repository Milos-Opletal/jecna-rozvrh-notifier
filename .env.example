# ==========================================
# Ječná Rozvrh Notifier Configuration
# ==========================================

# Check interval in seconds (900 = 15 minutes)
CHECK_INTERVAL_SECONDS=900

# Target class name (e.g. C4b) - žádné přihlašovací údaje nejsou potřeba!
CLASS_NAME=C4b

# Send notification for existing changes on first container start (true/false)
ALERT_ON_STARTUP=false

# Při nalezení změny poslat v notifikaci kompletní aktuální rozpis všech platných suplování (true/false)
REPEAT_ALL_CHANGES=true

# Časové pásmo kontejneru (výchozí: Europe/Prague)
# Zajišťuje, že čas v kontejneru odpovídá lokálnímu českému času (CET/CEST) a ranní notifikace odejde
# v požadovaný lokální čas (např. 07:00), nikoliv v UTC (+00:00).
TZ=Europe/Prague

# --- RANNÍ NOTIFIKACE (souhrn na daný den) ---
# Zapnutí / vypnutí ranní notifikace (true/false)
MORNING_NOTIFICATION_ENABLED=true

# Čas odeslání ranní notifikace ve formátu HH:MM (např. 07:00).
# Řídí se lokálním časem kontejneru definovaným v TZ (výchozí Europe/Prague).
MORNING_NOTIFICATION_TIME=07:00

# Cílové služby (webhooky), kam se má ranní notifikace odeslat.
# Všechny možné hodnoty (case-insensitive):
#   - all nebo *                                -> Všechny nakonfigurované služby (výchozí)
#   - ha, haos, homeassistant, home_assistant   -> Pouze Home Assistant webhook
#   - discord                                   -> Pouze Discord webhook
#   - telegram, tg                              -> Pouze Telegram bot
#   - ntfy, ntfy.sh                             -> Pouze ntfy push notifikace na mobil
#   - slack                                     -> Pouze Slack webhook
#   - generic, custom                           -> Pouze obecný HTTP JSON webhook
# Lze kombinovat oddělením čárkou, např.:
#   MORNING_NOTIFICATION_TARGETS=all            (všechny)
#   MORNING_NOTIFICATION_TARGETS=haos           (jen Home Assistant)
#   MORNING_NOTIFICATION_TARGETS=haos,discord   (Home Assistant + Discord)
#   MORNING_NOTIFICATION_TARGETS=ntfy,telegram  (ntfy + Telegram)
MORNING_NOTIFICATION_TARGETS=all

# Poslat ranní notifikaci pouze v případě, že jsou pro daný den evidovány nějaké změny (true/false).
# - true  = pošle notifikaci pouze, pokud jsou pro dnešek nějaké změny (suplování, odpadnutí, oznámení)
# - false = pošle notifikaci každé ráno i v případě, že platí beze změny stálý rozvrh
MORNING_NOTIFICATION_ONLY_IF_CHANGES=true

# API URL
SUBSTITUTION_API_URL=https://jecnarozvrh.jzitnik.dev/versioned/v3

# --- WEBHOOKS (fill any that you want to use) ---

# 1. Home Assistant Webhook URL
# http://<YOUR_HA_IP>:8123/api/webhook/<WEBHOOK_ID>
HOMEASSISTANT_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/jecna_supl_webhook

# 2. Discord Webhook URL
# https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_URL=

# 3. Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. ntfy.sh (Open-source free push notifications to phone)
# https://ntfy.sh/<your_secret_topic>
NTFY_URL=https://ntfy.sh/jecna_supl_notifikace

# 5. Slack Webhook URL
SLACK_WEBHOOK_URL=

# 6. Generic JSON Webhook URL
GENERIC_WEBHOOK_URL=
